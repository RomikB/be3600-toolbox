<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BE3600Toolbox.Desktop.Views.PasswordDialogWindow"
        Title="Авторизация"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="24" Spacing="14">
        <TextBlock Name="PromptTextBlock"
                   Text="Введите пароль администратора роутера:"
                   FontWeight="SemiBold"
                   FontSize="14" />

        <TextBox Name="PasswordBox"
                 PasswordChar="*"
                 Watermark="Пароль"
                 VerticalAlignment="Center" />

        <CheckBox Name="ShowPasswordCheckBox"
                  Content="Показать пароль"
                  IsChecked="False"
                  Click="OnShowPasswordClick" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,8,0,0">
            <Button Content="Отмена"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Width="90"
                    HorizontalContentAlignment="Center" />
            <Button Content="OK"
                    Click="OnOkClick"
                    Classes="accent"
                    IsDefault="True"
                    Width="90"
                    HorizontalContentAlignment="Center" />
        </StackPanel>
    </StackPanel>
</Window>
