<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BE3600Toolbox.Desktop.Views.InputDialogWindow"
        Title="Ввод данных"
        Width="440" Height="210"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Name="PromptTextBlock"
                   Grid.Row="0"
                   Text="Введите значение:"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <TextBox Name="InputTextBox"
                 Grid.Row="1"
                 Watermark="Введите текст..."
                 VerticalAlignment="Center" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,16,0,0">
            <Button Content="Отмена"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Width="90"
                    HorizontalContentAlignment="Center" />
            <Button Content="OK"
                    Click="OnOkClick"
                    Classes="accent"
                    IsDefault="True"
                    Width="90"
                    HorizontalContentAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
